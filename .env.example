# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID сотрудников, которым разрешено пользоваться ботом (бариста/промоутеры).
# Через запятую, без пробелов вокруг чисел не обязательно. Пример:
# STAFF_IDS=111111111,222222222
# Если оставить пустым — бот пока открыт для всех (удобно на этапе теста,
# ОБЯЗАТЕЛЬНО заполнить перед реальным запуском).
STAFF_IDS=

# Telegram ID администраторов (сейчас используется как резервный список с полным доступом).
ADMIN_IDS=

# Список локаций через запятую. Пока одна точка — просто одно значение.
# Первое значение используется автоматически, пока точка одна.
LOCATIONS=Taganka

# Путь к файлу SQLite (на Railway можно оставить по умолчанию).
DB_PATH=wheel.db

# Необязательно: выгрузка каждого спина/погашения в Google Sheets.
# См. README, раздел "Выгрузка в Google Sheets". Если оставить пустыми —
# бот работает как раньше, только через SQLite.
#
# Весь JSON-ключ сервисного аккаунта одной строкой (его присылает Google
# Cloud Console при создании ключа):
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID таблицы — длинная строка из её ссылки:
# https://docs.google.com/spreadsheets/d/ЭТОТ_КУСОК/edit
GOOGLE_SHEET_ID=

# Смещение от UTC (часы) для расчёта сроков действия призов; Москва = 3.
# TZ_OFFSET_HOURS=3
